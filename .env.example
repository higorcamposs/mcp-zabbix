# Copie para `.env` (ignorado pelo git) e ajuste. Variáveis já exportadas no
# shell, ou no `env` do cliente MCP, têm prioridade sobre este arquivo.

# URL base do Zabbix (o /api_jsonrpc.php é acrescentado sozinho).
# O valor abaixo aponta para o Zabbix do docker-compose.yml deste repositório.
ZABBIX_URL=http://localhost:8080

# Autenticação — use UMA das duas formas.
# 1) Token de API (Users > API tokens no Zabbix). Recomendado fora do laboratório.
# ZABBIX_API_TOKEN=
# 2) Usuário e senha. Estes são os padrões de fábrica do Zabbix: troque em
#    qualquer ambiente que não seja o laboratório local.
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix

# true = só consultas; as Tools que criam, alteram ou apagam recusam a chamada.
ZABBIX_READ_ONLY=false

# false desliga a verificação do certificado (só para HTTPS com certificado próprio).
ZABBIX_VERIFY_TLS=true
ZABBIX_TIMEOUT_SECONDS=15

# Transporte do servidor MCP: stdio (padrão, o cliente MCP inicia o processo)
# ou streamable-http (o servidor fica de pé em MCP_HOST:MCP_PORT/mcp).
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_LOG_LEVEL=INFO
